<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LTFC</RootNamespace>
    <AssemblyName>LTFC</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\assets\LTFC.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <!-- 发行标记 V1.0.2_a -->
    <InformationalVersion>1.0.2_a</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Lots_Tools_For_Class</Product>
    <AssemblyTitle>LTFC</AssemblyTitle>
    <Company>Lots_Tools_For_Class</Company>
    <Copyright>Lots_Tools_For_Class</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LTFC.Core\LTFC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 说明文档随程序复制到输出目录 -->
    <None Include="..\..\README.md" Condition="Exists('..\..\README.md')">
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 内置资源：赞赏码（在“总设置 → 关于”中显示） -->
    <None Include="..\..\..\assets\赞赏码.jpg" Condition="Exists('..\..\..\assets\赞赏码.jpg')">
      <Link>assets\赞赏码.jpg</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\assets\LTFC.ico" Condition="Exists('..\..\..\assets\LTFC.ico')">
      <Link>assets\LTFC.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
